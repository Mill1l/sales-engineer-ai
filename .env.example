# Phase 4B preparation: Mock/dry-run by default; no real credentials here.
AI_PROVIDER=mock
AI_ALLOW_PAID_CALLS=no
# Future opt-in Live: AI_PROVIDER=deepseek AND AI_ALLOW_PAID_CALLS=yes.
# Paste a NEW key locally into ignored .env.local using your editor, never in chat/source.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
# Alternative: deepseek-v4-pro. Official base URL is fixed in the server adapter.
# Legacy OpenAI adapter remains optional; it also requires AI_ALLOW_PAID_CALLS=yes.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
AI_TIMEOUT_MS=25000
AI_PARSE_MAX_TOKENS=4500
AI_EMAIL_MAX_TOKENS=1200
AI_CALLS_PER_MINUTE=20
AI_CALLS_PER_DAY=100
# Keys must NEVER use NEXT_PUBLIC_ prefixes.
# Script-only opt-in; distinct from the server gate above. Keep commented by default.
# ALLOW_PAID_SMOKE_TEST=yes
# SMOKE_BASE_URL=http://127.0.0.1:3000
# SMOKE_PROVIDER=deepseek
